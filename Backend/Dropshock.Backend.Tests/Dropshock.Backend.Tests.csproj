<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Targets net8.0 so it builds on an 8.0 SDK, but rolls forward onto a newer
       runtime. Dev machines here have .NET 10 and no 8.0 runtime; without this the
       app builds fine and then refuses to launch. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dropshock.Backend/Dropshock.Backend.csproj" />
  </ItemGroup>
</Project>
